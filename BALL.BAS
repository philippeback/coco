10 ' AMIGA BOING BALL - HARDWARE PAGE FLIPPING + TRANSPARENT MASK
20 ' PMODE 3, SCREEN 1,1 (5=BUFF, 6=CYAN, 7=MAGENTA, 8=ORANGE)
25 POKE 65495,0
30 PCLEAR 8
40 PMODE 3,1:PCLS 5:SCREEN 1,1
50 DIM B0(75),B1(75),B2(75),B3(75),MK(75),G0(75),G1(75)
60 RA=22:R2=RA*RA:P0=3.14159/8
70 ' BUILD TRANSPARENCY MASK (BUFF OUTSIDE, BLACK INSIDE)
80 PMODE 4,1:PCLS 1
90 FOR DY=-RA TO RA
100 X0=SQR(R2-DY*DY)
110 LINE(32-X0,32+DY)-(32+X0,32+DY),PRESET
120 NEXT DY
130 PMODE 3,1:GET(8,8)-(56,56),MK,G
140 ' PRE-RENDER 4 ROTATION FRAMES (BLACK OUTSIDE SO OR-BLIT IS TRANSPARENT)
150 FOR F=0 TO 3
160 PMODE 4,1:PCLS 0:PMODE 3,1
170 FP=F*P0/4
180 FOR DY=-RA TO RA STEP 2
190 Y2=DY*DY:X0=SQR(R2-Y2)
200 LA=INT((DY+RA)/(RA/3))
210 FOR DX=-X0 TO X0 STEP 2
220 LO=INT((ATN(DX/(SQR(ABS(R2-DX*DX-Y2))+.01))+1.57+FP-DY*.012)/P0)
230 C=5+((LA+LO) AND 1)*3
240 LINE(32+DX,32+DY)-(32+DX,32+DY+1),PSET,B
250 PSET(32+DX,32+DY,C):PSET(32+DX,32+DY+1,C)
260 NEXT DX,DY
270 CIRCLE(32,32),RA,8
280 IF F=0 THEN GET(8,8)-(56,56),B0,G
290 IF F=1 THEN GET(8,8)-(56,56),B1,G
300 IF F=2 THEN GET(8,8)-(56,56),B2,G
310 IF F=3 THEN GET(8,8)-(56,56),B3,G
320 NEXT F
330 ' DRAW AMIGA STYLE GRID BACKGROUND ON PAGE 1
340 PMODE 3,1:PCLS 5:COLOR 7,5
350 FOR Y=16 TO 152 STEP 16
360 LINE(32,Y)-(224,Y),PSET
370 NEXT Y
380 FOR X=32 TO 224 STEP 16
390 LINE(X,16)-(X,152),PSET
400 NEXT X
410 FOR I=0 TO 12
420 X1=32+I*16:X2=4+I*20
430 LINE(X1,152)-(X2,188),PSET
440 NEXT I
450 LINE(23,162)-(233,162),PSET
460 LINE(14,174)-(242,174),PSET
470 LINE(4,188)-(252,188),PSET
480 ' COPY BACKGROUND TO PAGE 5 (SECOND BUFFER)
490 PCOPY 1 TO 5:PCOPY 2 TO 6:PCOPY 3 TO 7:PCOPY 4 TO 8
500 ' INITIALIZE DOUBLE-BUFFERED BOUNCE STATE
510 BX=40:BY=20:VX=8:VY=0:GY=3:FR=0:DR=1
520 X0=BX:Y0=BY:X1=BX:Y1=BY
530 PMODE 3,1:GET(X0,Y0)-(X0+48,Y0+48),G0,G
540 PMODE 3,5:GET(X1,Y1)-(X1+48,Y1+48),G1,G
550 ' --- MAIN DOUBLE-BUFFERED LOOP ---
560 ' 1) RENDER ON HIDDEN PAGE 5 WHILE PAGE 1 IS DISPLAYED
570 PMODE 3,5
580 PUT(X1,Y1)-(X1+48,Y1+48),G1,PSET
590 GOSUB 700
600 X1=BX:Y1=BY:GET(X1,Y1)-(X1+48,Y1+48),G1,G
610 PUT(X1,Y1)-(X1+48,Y1+48),MK,AND
620 ON FR+1 GOSUB 760,770,780,790
630 SCREEN 1,1
640 ' 2) RENDER ON HIDDEN PAGE 1 WHILE PAGE 5 IS DISPLAYED
650 PMODE 3,1
660 PUT(X0,Y0)-(X0+48,Y0+48),G0,PSET
670 GOSUB 700
680 X0=BX:Y0=BY:GET(X0,Y0)-(X0+48,Y0+48),G0,G
690 PUT(X0,Y0)-(X0+48,Y0+48),MK,AND
692 ON FR+1 GOSUB 760,770,780,790
694 SCREEN 1,1
696 GOTO 560
700 ' --- PHYSICS & SOUND SUBROUTINE ---
710 BX=BX+VX:BY=BY+VY:VY=VY+GY
720 IF BX<16 THEN BX=16:VX=-VX:DR=-DR:SOUND 140,1
730 IF BX>190 THEN BX=190:VX=-VX:DR=-DR:SOUND 140,1
740 IF BY>132 THEN BY=132:VY=-24:SOUND 60,1
750 FR=(FR+DR) AND 3:RETURN
760 PUT(BX,BY)-(BX+48,BY+48),B0,OR:RETURN
770 PUT(BX,BY)-(BX+48,BY+48),B1,OR:RETURN
780 PUT(BX,BY)-(BX+48,BY+48),B2,OR:RETURN
790 PUT(BX,BY)-(BX+48,BY+48),B3,OR:RETURN
