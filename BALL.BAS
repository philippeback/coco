10 ' AMIGA BOING BALL FOR TANDY COCO 1 EXTENDED BASIC
20 ' PMODE 3, SCREEN 1,1 (5=BUFF, 6=CYAN, 7=MAGENTA, 8=ORANGE)
25 POKE 65495,0
30 PCLEAR4
40 PMODE3,1:PCLS6:SCREEN1,1
50 DIMB0(75),B1(75),B2(75),B3(75),BG(75)
60 RA=22:R2=RA*RA:P0=3.14159/8
70 ' PRE-RENDER 4 ROTATION FRAMES OF CHECKERED SPHERE
80 FOR F=0 TO 3
90 PCLS 5
100 FP=F*P0/4
110 FOR DY=-RA TO RA STEP 2
120 Y2=DY*DY:X0=SQR(R2-Y2)
130 LA=INT((DY+RA)/(RA/3))
140 FOR DX=-X0 TO X0 STEP 2
150 ' SPHERICAL PROJECTION & TILT APPROXIMATION
155 Z2=R2-DX*DX-Y2:IF Z2<0 THEN Z2=0
160 LO=INT((ATN(DX/(SQR(Z2)+.01))+1.57+FP-DY*.012)/P0)
170 C=5+((LA+LO) AND 1)*3
180 PSET(32+DX,32+DY,C)
190 NEXT DX,DY
200 CIRCLE(32,32),RA,8
210 IFF=0THENGET(8,8)-(56,56),B0,G
220 IFF=1THENGET(8,8)-(56,56),B1,G
230 IFF=2THENGET(8,8)-(56,56),B2,G
240 IFF=3THENGET(8,8)-(56,56),B3,G
250 NEXTF
260 ' DRAW AMIGA STYLE GRID BACKGROUND (CYAN ON BUFF)
270 PCLS5
280 ' BACK WALL GRID
285 COLOR 7,5
290 FOR Y=16 TO 152 STEP 16
300 LINE(32,Y)-(224,Y),PSET
310 NEXT Y
320 FOR X=32 TO 224 STEP 16
330 LINE(X,16)-(X,152),PSET
340 NEXT X
350 ' PERSPECTIVE FLOOR GRID
360 FOR I=0 TO 12
370 X1=32+I*16:X2=4+I*20
380 LINE(X1,152)-(X2,188),PSET
390 NEXT I
400 LINE(23,162)-(233,162),PSET
410 LINE(14,174)-(242,174),PSET
420 LINE(4,188)-(252,188),PSET
430 ' INITIALIZE BOUNCE PHYSICS (ALL 2-CHAR SAFE VARS!)
440 BX=40:BY=20:VX=6:VY=0:GY=3:FR=0:DR=1
450 ' SAVE INITIAL BACKGROUND PATCH
460 GET(BX,BY)-(BX+48,BY+48),BG,G
470 ' MAIN ANIMATION LOOP
480 PUT(BX,BY)-(BX+48,BY+48),BG,PSET
490 BX=BX+VX:BY=BY+VY:VY=VY+GY
500 ' WALL BOUNCE
510 IFBX<16THENBX=16:VX=-VX:DR=-DR:SOUND140,1
520 IFBX>190THENBX=190:VX=-VX:DR=-DR:SOUND140,1
530 ' FLOOR BOUNCE
540 IFBY>132THENBY=132:VY=-24:SOUND60,1
550 ' ADVANCE ROTATION FRAME
560 FR=(FR+DR)AND3
570 ' CAPTURE NEW BACKGROUND & DRAW BALL
580 GET(BX,BY)-(BX+48,BY+48),BG,G
590 ONFR+1GOTO600,610,620,630
600 PUT(BX,BY)-(BX+48,BY+48),B0,PSET:GOTO480
610 PUT(BX,BY)-(BX+48,BY+48),B1,PSET:GOTO480
620 PUT(BX,BY)-(BX+48,BY+48),B2,PSET:GOTO480
630 PUT(BX,BY)-(BX+48,BY+48),B3,PSET:GOTO480
 