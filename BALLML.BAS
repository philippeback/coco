10 ' AMIGA BOING BALL - 6809 MACHINE LANGUAGE 60FPS HYBRID
20 ' PMODE 3, SCREEN 1,1 (5=BUFF, 6=CYAN, 7=MAGENTA, 8=ORANGE)
25 POKE 65495,0
30 PCLEAR 8
35 CLEAR 200,&H5FFF
40 PMODE 3,1:PCLS 5:SCREEN 1,1
50 ' 1) LOAD 6809 MACHINE LANGUAGE ENGINE INTO $7D00..$7EF7
60 A=&H7D00
70 FOR L=1 TO 23:READ H$
80 FOR I=1 TO LEN(H$) STEP 2
90 POKE A,VAL("&H"+MID$(H$,I,2)):A=A+1
100 NEXT I,L
110 DEFUSR0=&H7D00:DEFUSR1=&H7D03
120 ' 2) BUILD CIRCULAR AND-MASK AT $6000 (576 BYTES)
130 RA=22:R2=RA*RA:P0=3.14159/8
140 PMODE 4,1:PCLS 1
150 FOR DY=-RA TO RA
160 X0=SQR(R2-DY*DY)
170 LINE(32-X0,32+DY)-(32+X0,32+DY),PRESET
180 NEXT DY
190 PMODE 3,1:SCREEN 1,1
200 AD=&H6000:GOSUB 800
210 ' 3) PRE-RENDER 8 SMOOTH ROTATION FRAMES AT $6240..$743F
220 FOR F=0 TO 7
230 PMODE 4,1:PCLS 0:PMODE 3,1:SCREEN 1,1
240 FP=F*P0/8
250 FOR DY=-RA TO RA STEP 2
260 Y2=DY*DY:X0=SQR(R2-Y2)
270 LA=INT((DY+RA)/(RA/3))
280 FOR DX=-X0 TO X0 STEP 2
290 LO=INT((ATN(DX/(SQR(ABS(R2-DX*DX-Y2))+.01))+1.57+FP-DY*.012)/P0)
300 C=5+((LA+LO) AND 1)*3
310 PSET(32+DX,32+DY,C):PSET(32+DX,32+DY+1,C)
320 NEXT DX,DY
330 CIRCLE(32,32),RA,8
340 AD=&H6240+F*576:GOSUB 800
350 NEXT F
360 ' 4) DRAW AMIGA GRID ON PAGE 1 ($0E00) AND COPY TO PAGE 5 ($2600)
370 PMODE 3,1:PCLS 5:COLOR 7,5:SCREEN 1,1
380 FOR Y=16 TO 152 STEP 16
390 LINE(32,Y)-(224,Y),PSET
400 NEXT Y
410 FOR X=32 TO 224 STEP 16
420 LINE(X,16)-(X,152),PSET
430 NEXT X
440 FOR I=0 TO 12
450 X1=32+I*16:X2=4+I*20
460 LINE(X1,152)-(X2,188),PSET
470 NEXT I
480 LINE(23,162)-(233,162),PSET
490 LINE(14,174)-(242,174),PSET
500 LINE(4,188)-(252,188),PSET
510 PCOPY 1 TO 5:PCOPY 2 TO 6:PCOPY 3 TO 7:PCOPY 4 TO 8
520 ' 5) LAUNCH 60FPS 6809 MACHINE LANGUAGE ENGINE! (PRESS BREAK TO EXIT)
530 Z=USR1(0)
540 END
800 ' CALL 6809 USR0 TO COPY 48X48 PATCH (576 BYTES) TO ADDRESS AD
810 POKE &H7FFE,INT(AD/256):POKE &H7FFF,AD-INT(AD/256)*256
820 Z=USR0(0):RETURN
