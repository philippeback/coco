                      (C:\Dev\github\philippeback\coco\):00001 ; =============================================================================
                      (C:\Dev\github\philippeback\coco\):00002 ; BALLML.ASM - 6809 Machine Language 60 FPS Boing Ball Engine for Tandy CoCo 1
                      (C:\Dev\github\philippeback\coco\):00003 ; Assemble with:
                      (C:\Dev\github\philippeback\coco\):00004 ;   lwasm -9 -b -f raw -o ballml.raw --list=ballml.lst BALLML.ASM
                      (C:\Dev\github\philippeback\coco\):00005 ; =============================================================================
                      (C:\Dev\github\philippeback\coco\):00006 ; Memory Map (with PCLEAR 8 and CLEAR 200,&H5FFF):
                      (C:\Dev\github\philippeback\coco\):00007 ;   $0600-$1DFF : Video Buffer A (Pages 1-4, PMODE 3) -> Base stored at $00BC!
                      (C:\Dev\github\philippeback\coco\):00008 ;   $1E00-$35FF : Video Buffer B (Pages 5-8, PMODE 3) -> Base + $1800!
                      (C:\Dev\github\philippeback\coco\):00009 ;   $6000-$623F : Circular AND Mask (12 bytes x 48 rows = 576 bytes)
                      (C:\Dev\github\philippeback\coco\):00010 ;   $6240-$743F : 8 Rotation Frames (8 x 576 bytes = 4608 bytes)
                      (C:\Dev\github\philippeback\coco\):00011 ;   $7440-$767F : Saved Background Patch G0 (Page 1, 576 bytes)
                      (C:\Dev\github\philippeback\coco\):00012 ;   $7680-$78BF : Saved Background Patch G1 (Page 5, 576 bytes)
                      (C:\Dev\github\philippeback\coco\):00013 ;   $7D00-$7FFF : 6809 Machine Language Engine & State Variables
                      (C:\Dev\github\philippeback\coco\):00014 ; =============================================================================
                      (C:\Dev\github\philippeback\coco\):00015 
                      (C:\Dev\github\philippeback\coco\):00016         ORG     $7D00
                      (C:\Dev\github\philippeback\coco\):00017 
                      (C:\Dev\github\philippeback\coco\):00018 ;Fixed entry points for BASIC DEFUSR0 and DEFUSR1:
7D00 7E7D12           (C:\Dev\github\philippeback\coco\):00019 USR0_ENTRY      JMP     CAPTURE_PATCH   ; $7D00: Copy 48x48 from (8,8) to [$7FFE]
7D03 7E7D68           (C:\Dev\github\philippeback\coco\):00020 USR1_ENTRY      JMP     RUN_ENGINE      ; $7D03: Run 60 FPS page-flipped bounce loop
                      (C:\Dev\github\philippeback\coco\):00021 
                      (C:\Dev\github\philippeback\coco\):00022 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00023 ; State Variables
                      (C:\Dev\github\philippeback\coco\):00024 ; -----------------------------------------------------------------------------
7D06 10               (C:\Dev\github\philippeback\coco\):00025 BX_SUB          FCB     16              ; X byte col * 4 (8..72 -> col 2..18)
7D07 01               (C:\Dev\github\philippeback\coco\):00026 VX_SUB          FCB     1               ; Horizontal speed (+1 or -1)
7D08 0140             (C:\Dev\github\philippeback\coco\):00027 BY_FP           FDB     $0140           ; 12.4 fixed-point Y (20 * 16 = 320)
7D0A 0000             (C:\Dev\github\philippeback\coco\):00028 VY_FP           FDB     $0000           ; 12.4 fixed-point vertical velocity
7D0C 00               (C:\Dev\github\philippeback\coco\):00029 FR_CNT          FCB     0               ; Rotation counter
7D0D 01               (C:\Dev\github\philippeback\coco\):00030 DR_STEP         FCB     1               ; Rotation direction (+1 or -1)
7D0E 0884             (C:\Dev\github\philippeback\coco\):00031 OLD0_ADDR       FDB     $0884           ; Previous ball address on Page 1 ($0600)
7D10 2084             (C:\Dev\github\philippeback\coco\):00032 OLD1_ADDR       FDB     $2084           ; Previous ball address on Page 5 ($1E00)
                      (C:\Dev\github\philippeback\coco\):00033 
                      (C:\Dev\github\philippeback\coco\):00034 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00035 ; USR0 ($7D00 -> CAPTURE_PATCH):
                      (C:\Dev\github\philippeback\coco\):00036 ;   Copies 48x48 patch (12 bytes x 48 scanlines = 576 bytes) from (8,8) on
                      (C:\Dev\github\philippeback\coco\):00037 ;   Page 1 ($0600 + 8*32 + 1 = $0701) to destination address in $7FFE:$7FFF.
                      (C:\Dev\github\philippeback\coco\):00038 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00039 CAPTURE_PATCH:
7D12 3476             (C:\Dev\github\philippeback\coco\):00040         PSHS    U,Y,X,D
7D14 8E0701           (C:\Dev\github\philippeback\coco\):00041         LDX     #$0701                  ; Source = (8,8) on Page 1 ($0600 + $0101)
7D17 FE7FFE           (C:\Dev\github\philippeback\coco\):00042         LDU     $7FFE                   ; Destination address poked by BASIC
7D1A 8D02             (C:\Dev\github\philippeback\coco\):00043         BSR     SAVE_BG
7D1C 35F6             (C:\Dev\github\philippeback\coco\):00044         PULS    D,X,Y,U,PC
                      (C:\Dev\github\philippeback\coco\):00045 
                      (C:\Dev\github\philippeback\coco\):00046 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00047 ; SAVE_BG: Copy 48 rows x 12 bytes from screen (X) to linear buffer (U)
                      (C:\Dev\github\philippeback\coco\):00048 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00049 SAVE_BG:
7D1E C630             (C:\Dev\github\philippeback\coco\):00050         LDB     #48
                      (C:\Dev\github\philippeback\coco\):00051 SAVE_ROW:
7D20 3404             (C:\Dev\github\philippeback\coco\):00052         PSHS    B
7D22 EC81             (C:\Dev\github\philippeback\coco\):00053         LDD     ,X++
7D24 EDC1             (C:\Dev\github\philippeback\coco\):00054         STD     ,U++
7D26 EC81             (C:\Dev\github\philippeback\coco\):00055         LDD     ,X++
7D28 EDC1             (C:\Dev\github\philippeback\coco\):00056         STD     ,U++
7D2A EC81             (C:\Dev\github\philippeback\coco\):00057         LDD     ,X++
7D2C EDC1             (C:\Dev\github\philippeback\coco\):00058         STD     ,U++
7D2E EC81             (C:\Dev\github\philippeback\coco\):00059         LDD     ,X++
7D30 EDC1             (C:\Dev\github\philippeback\coco\):00060         STD     ,U++
7D32 EC81             (C:\Dev\github\philippeback\coco\):00061         LDD     ,X++
7D34 EDC1             (C:\Dev\github\philippeback\coco\):00062         STD     ,U++
7D36 EC81             (C:\Dev\github\philippeback\coco\):00063         LDD     ,X++
7D38 EDC1             (C:\Dev\github\philippeback\coco\):00064         STD     ,U++
7D3A 308814           (C:\Dev\github\philippeback\coco\):00065         LEAX    20,X                    ; Next scanline (32 - 12 = 20)
7D3D 3504             (C:\Dev\github\philippeback\coco\):00066         PULS    B
7D3F 5A               (C:\Dev\github\philippeback\coco\):00067         DECB
7D40 26DE             (C:\Dev\github\philippeback\coco\):00068         BNE     SAVE_ROW
7D42 39               (C:\Dev\github\philippeback\coco\):00069         RTS
