7E3A A480             (C:\Dev\github\philippeback\coco\):00221         ANDA    ,X+
7E3C E480             (C:\Dev\github\philippeback\coco\):00222         ANDB    ,X+
7E3E AAA0             (C:\Dev\github\philippeback\coco\):00223         ORA     ,Y+
7E40 EAA0             (C:\Dev\github\philippeback\coco\):00224         ORB     ,Y+
7E42 EDC1             (C:\Dev\github\philippeback\coco\):00225         STD     ,U++
