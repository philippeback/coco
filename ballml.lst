                      (C:\Dev\github\philippeback\coco\):00097 ; USR1 ($7D03 -> RUN_ENGINE):
                      (C:\Dev\github\philippeback\coco\):00098 ;   Main 60 FPS VSYNC-locked hardware page-flipping animation loop
                      (C:\Dev\github\philippeback\coco\):00099 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00100 RUN_ENGINE:
7D68 347F             (C:\Dev\github\philippeback\coco\):00101         PSHS    CC,DP,U,Y,X,D
7D6A 1A50             (C:\Dev\github\philippeback\coco\):00102         ORCC    #$50                    ; Disable IRQ/FIRQ during high-speed blitting
                      (C:\Dev\github\philippeback\coco\):00103 
                      (C:\Dev\github\philippeback\coco\):00104         ; Initialize state variables
7D6C CC1001           (C:\Dev\github\philippeback\coco\):00105         LDD     #$1001                  ; BX_SUB = 16 (col 4), VX_SUB = +1
7D6F FD7D06           (C:\Dev\github\philippeback\coco\):00106         STD     BX_SUB
7D72 CC0140           (C:\Dev\github\philippeback\coco\):00107         LDD     #$0140                  ; BY_FP = 20 * 16
7D75 FD7D08           (C:\Dev\github\philippeback\coco\):00108         STD     BY_FP
7D78 CC0000           (C:\Dev\github\philippeback\coco\):00109         LDD     #$0000                  ; VY_FP = 0
7D7B FD7D0A           (C:\Dev\github\philippeback\coco\):00110         STD     VY_FP
7D7E CC0001           (C:\Dev\github\philippeback\coco\):00111         LDD     #$0001                  ; FR_CNT = 0, DR_STEP = +1
7D81 FD7D0C           (C:\Dev\github\philippeback\coco\):00112         STD     FR_CNT
7D84 CC0884           (C:\Dev\github\philippeback\coco\):00113         LDD     #$0884                  ; $0600 + 20*32 + 4 = $0884
7D87 FD7D0E           (C:\Dev\github\philippeback\coco\):00114         STD     OLD0_ADDR
7D8A CC2084           (C:\Dev\github\philippeback\coco\):00115         LDD     #$2084                  ; $1E00 + 20*32 + 4 = $2084
7D8D FD7D10           (C:\Dev\github\philippeback\coco\):00116         STD     OLD1_ADDR
                      (C:\Dev\github\philippeback\coco\):00117 
                      (C:\Dev\github\philippeback\coco\):00118         ; Save initial background patches into G0 ($7440) and G1 ($7680)
7D90 BE7D0E           (C:\Dev\github\philippeback\coco\):00119         LDX     OLD0_ADDR
7D93 CE7440           (C:\Dev\github\philippeback\coco\):00120         LDU     #$7440
7D96 BD7D1E           (C:\Dev\github\philippeback\coco\):00121         JSR     SAVE_BG
7D99 BE7D10           (C:\Dev\github\philippeback\coco\):00122         LDX     OLD1_ADDR
7D9C CE7680           (C:\Dev\github\philippeback\coco\):00123         LDU     #$7680
7D9F BD7D1E           (C:\Dev\github\philippeback\coco\):00124         JSR     SAVE_BG
                      (C:\Dev\github\philippeback\coco\):00125 
                      (C:\Dev\github\philippeback\coco\):00126 MAIN_LOOP:
                      (C:\Dev\github\philippeback\coco\):00127         ; --- 1) Render on hidden Page 5 ($1E00) while Page 1 ($0600) is shown ---
7DA2 FE7D10           (C:\Dev\github\philippeback\coco\):00128         LDU     OLD1_ADDR
7DA5 8E7680           (C:\Dev\github\philippeback\coco\):00129         LDX     #$7680                  ; G1 background buffer
7DA8 BD7D43           (C:\Dev\github\philippeback\coco\):00130         JSR     RESTORE_BG
                      (C:\Dev\github\philippeback\coco\):00131 
7DAB BD7E7F           (C:\Dev\github\philippeback\coco\):00132         JSR     STEP_PHYSICS            ; Returns D = Y*32 + X_col
7DAE C31E00           (C:\Dev\github\philippeback\coco\):00133         ADDD    #$1E00                  ; Add Page 5 base address ($1E00)
7DB1 FD7D10           (C:\Dev\github\philippeback\coco\):00134         STD     OLD1_ADDR
7DB4 1F01             (C:\Dev\github\philippeback\coco\):00135         TFR     D,X
7DB6 CE7680           (C:\Dev\github\philippeback\coco\):00136         LDU     #$7680
7DB9 BD7D1E           (C:\Dev\github\philippeback\coco\):00137         JSR     SAVE_BG
                      (C:\Dev\github\philippeback\coco\):00138 
7DBC FE7D10           (C:\Dev\github\philippeback\coco\):00139         LDU     OLD1_ADDR
7DBF BD7E0B           (C:\Dev\github\philippeback\coco\):00140         JSR     DRAW_BALL
                      (C:\Dev\github\philippeback\coco\):00141 
7DC2 BD7EDE           (C:\Dev\github\philippeback\coco\):00142         JSR     WAIT_VSYNC
                      (C:\Dev\github\philippeback\coco\):00143         ; Flip SAM display address to Page 5 ($1E00 -> F = 15 = %0001111):
                      (C:\Dev\github\philippeback\coco\):00144         ; Page 1 ($0600) is F = 3 (%0000011). Set F2 ($FFCB) and F3 ($FFCD)!
7DC5 B7FFCB           (C:\Dev\github\philippeback\coco\):00145         STA     $FFCB                   ; Set SAM F2
7DC8 B7FFCD           (C:\Dev\github\philippeback\coco\):00146         STA     $FFCD                   ; Set SAM F3 -> Page 5 ($1E00) now visible!
                      (C:\Dev\github\philippeback\coco\):00147 
                      (C:\Dev\github\philippeback\coco\):00148         ; --- 2) Render on hidden Page 1 ($0600) while Page 5 ($1E00) is shown ---
7DCB FE7D0E           (C:\Dev\github\philippeback\coco\):00149         LDU     OLD0_ADDR
7DCE 8E7440           (C:\Dev\github\philippeback\coco\):00150         LDX     #$7440                  ; G0 background buffer
7DD1 BD7D43           (C:\Dev\github\philippeback\coco\):00151         JSR     RESTORE_BG
                      (C:\Dev\github\philippeback\coco\):00152 
7DD4 BD7E7F           (C:\Dev\github\philippeback\coco\):00153         JSR     STEP_PHYSICS            ; Returns D = Y*32 + X_col
7DD7 C30600           (C:\Dev\github\philippeback\coco\):00154         ADDD    #$0600                  ; Add Page 1 base address ($0600)
7DDA FD7D0E           (C:\Dev\github\philippeback\coco\):00155         STD     OLD0_ADDR
7DDD 1F01             (C:\Dev\github\philippeback\coco\):00156         TFR     D,X
7DDF CE7440           (C:\Dev\github\philippeback\coco\):00157         LDU     #$7440
7DE2 BD7D1E           (C:\Dev\github\philippeback\coco\):00158         JSR     SAVE_BG
                      (C:\Dev\github\philippeback\coco\):00159 
7DE5 FE7D0E           (C:\Dev\github\philippeback\coco\):00160         LDU     OLD0_ADDR
7DE8 BD7E0B           (C:\Dev\github\philippeback\coco\):00161         JSR     DRAW_BALL
                      (C:\Dev\github\philippeback\coco\):00162 
7DEB BD7EDE           (C:\Dev\github\philippeback\coco\):00163         JSR     WAIT_VSYNC
                      (C:\Dev\github\philippeback\coco\):00164         ; Flip SAM display address back to Page 1 ($0600 -> F = 3 = %0000011):
                      (C:\Dev\github\philippeback\coco\):00165         ; Clear F2 ($FFCA) and Clear F3 ($FFCC)!
7DEE B7FFCA           (C:\Dev\github\philippeback\coco\):00166         STA     $FFCA                   ; Clear SAM F2
7DF1 B7FFCC           (C:\Dev\github\philippeback\coco\):00167         STA     $FFCC                   ; Clear SAM F3 -> Page 1 ($0600) now visible!
                      (C:\Dev\github\philippeback\coco\):00168 
                      (C:\Dev\github\philippeback\coco\):00169         ; Check keyboard matrix for BREAK key to exit cleanly to BASIC
7DF4 86FB             (C:\Dev\github\philippeback\coco\):00170         LDA     #$FB                    ; Strobe column 2 (BREAK)
7DF6 B7FF02           (C:\Dev\github\philippeback\coco\):00171         STA     $FF02
7DF9 B6FF00           (C:\Dev\github\philippeback\coco\):00172         LDA     $FF00
7DFC 8440             (C:\Dev\github\philippeback\coco\):00173         ANDA    #$40                    ; Row 6 = BREAK
7DFE 2703             (C:\Dev\github\philippeback\coco\):00174         BEQ     EXIT_ENGINE
7E00 7E7DA2           (C:\Dev\github\philippeback\coco\):00175         JMP     MAIN_LOOP
                      (C:\Dev\github\philippeback\coco\):00176 
                      (C:\Dev\github\philippeback\coco\):00177 EXIT_ENGINE:
                      (C:\Dev\github\philippeback\coco\):00178         ; Ensure SAM display is pointing to Page 1 ($0600) before returning
7E03 B7FFCA           (C:\Dev\github\philippeback\coco\):00179         STA     $FFCA
7E06 B7FFCC           (C:\Dev\github\philippeback\coco\):00180         STA     $FFCC
7E09 35FF             (C:\Dev\github\philippeback\coco\):00181         PULS    D,X,Y,U,DP,CC,PC
                      (C:\Dev\github\philippeback\coco\):00182 
                      (C:\Dev\github\philippeback\coco\):00183 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00184 ; DRAW_BALL: Masked 48x48 sprite blit onto screen at U
                      (C:\Dev\github\philippeback\coco\):00185 ;   Mask:   $6000 (576 bytes)
                      (C:\Dev\github\philippeback\coco\):00186 ;   Sprite: $6240 + ((FR_CNT / 2) & 7) * 576
                      (C:\Dev\github\philippeback\coco\):00187 ; -----------------------------------------------------------------------------
                      (C:\Dev\github\philippeback\coco\):00188 DRAW_BALL:
7E0B B67D0C           (C:\Dev\github\philippeback\coco\):00189         LDA     FR_CNT
7E0E 44               (C:\Dev\github\philippeback\coco\):00190         LSRA                            ; Advance rotation every 2nd 60Hz frame
7E0F 8407             (C:\Dev\github\philippeback\coco\):00191         ANDA    #$07                    ; 8 rotation frames (0..7)
7E11 C609             (C:\Dev\github\philippeback\coco\):00192         LDB     #9                      ; 9 * 64 = 576 bytes per frame
7E13 3D               (C:\Dev\github\philippeback\coco\):00193         MUL                             ; D = frame * 9
7E14 58               (C:\Dev\github\philippeback\coco\):00194         ASLB
7E15 49               (C:\Dev\github\philippeback\coco\):00195         ROLA
7E16 58               (C:\Dev\github\philippeback\coco\):00196         ASLB
7E17 49               (C:\Dev\github\philippeback\coco\):00197         ROLA
7E18 58               (C:\Dev\github\philippeback\coco\):00198         ASLB
7E19 49               (C:\Dev\github\philippeback\coco\):00199         ROLA
7E1A 58               (C:\Dev\github\philippeback\coco\):00200         ASLB
7E1B 49               (C:\Dev\github\philippeback\coco\):00201         ROLA
7E1C 58               (C:\Dev\github\philippeback\coco\):00202         ASLB
7E1D 49               (C:\Dev\github\philippeback\coco\):00203         ROLA
7E1E 58               (C:\Dev\github\philippeback\coco\):00204         ASLB
7E1F 49               (C:\Dev\github\philippeback\coco\):00205         ROLA                            ; D = frame * 576 ($0240)
7E20 C36240           (C:\Dev\github\philippeback\coco\):00206         ADDD    #$6240
7E23 1F02             (C:\Dev\github\philippeback\coco\):00207         TFR     D,Y                     ; Y = current rotation frame pointer
7E25 8E6000           (C:\Dev\github\philippeback\coco\):00208         LDX     #$6000                  ; X = circular AND mask pointer
7E28 C630             (C:\Dev\github\philippeback\coco\):00209         LDB     #48                     ; 48 scanlines
                      (C:\Dev\github\philippeback\coco\):00210 DRAW_ROW:
